{
  "autoCompactWindow": 300000,
  "env": {
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1"
  },
  "permissions": {
    "deny": [
      "mcp__Roblox_Studio__generate_mesh",
      "mcp__Roblox_Studio__generate_material",
      "mcp__Roblox_Studio__generate_procedural_model",
      "mcp__Roblox_Studio__generate_scene",
      "mcp__Roblox_Studio__generate_texture",
      "mcp__Roblox_Studio__generate_avatar",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.codex/**)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git add . *)",
      "Bash(git add -u *)",
      "Bash(git add --update *)",
      "Bash(git commit -a *)",
      "Bash(git commit -am *)",
      "Bash(git commit --all *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push * -f *)",
      "PowerShell(git add -A *)",
      "PowerShell(git add --all *)",
      "PowerShell(git add . *)",
      "PowerShell(git add -u *)",
      "PowerShell(git add --update *)",
      "PowerShell(git commit -a *)",
      "PowerShell(git commit -am *)",
      "PowerShell(git commit --all *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force *)",
      "PowerShell(git push * --force-with-lease *)",
      "PowerShell(git push * -f *)",
      "mcp__ccd_session_mgmt__set_session_fast_mode",
      "Edit(/.claude/state/**)",
      "Read(~/.claude/team-hooks/**)",
      "Edit(~/.claude/team-hooks/**)"
    ],
    "ask": [
      "mcp__Roblox_Studio__insert_asset",
      "mcp__Roblox_Studio__http_get",
      "mcp__Roblox_Studio__auto_setup_avatar",
      "mcp__Roblox_Studio__segment_mesh",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/settings.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/role_recorder.py"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/drift_guard.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/role_recorder.py"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/drift_guard.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.*Roblox.*__open_cloud_invoke$",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/open_cloud_guard.py"
            ],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
