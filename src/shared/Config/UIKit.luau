--!strict
-- UIKit (shared config): the UI kit's images and palettes, as the game reads them. Written by
-- tools/ui/kit_config.py from Modulo's build/handoff/UI/kit/kit.json and build/handoff/UI/hud/hud_art.json (AR3,
-- sections 2 and 3), the lead card's build/handoff/UI/hud/lead_card/lead_card.json (tools/blender/lead_card_art.py)
-- and TR5's build/handoff/UI/hud/boss/boss.json (tools/blender/boss_hud_art.py),
-- with each image's group upload id: run it again after a re-cut, never edit by hand.
-- A slice is white where a palette colours it. Cut is left, top, right, bottom in points; Pad is how far an image
-- reaches past its piece's box on every side; At, a lead card image's box's top left in the card's points. The kit
-- draws them (src/client/UI/Kit, src/client/UI/LeadCard.luau). Systems: AR12's colour, a row a system
-- (build/handoff/UI/hud/colour/hud_colour.json): a piece of the HUD wears its system's body, edge, block and mark.

export type Image = { Id: string, Pixels: Vector2, Points: Vector2, Cut: { number }?, Pad: number, At: Vector2? }
export type System = {
	Colour: Color3,
	Pale: Color3,
	Deep: Color3,
	Icon: string, -- its icon in light
	Mark: string, -- its mark in ink, on its block
	Block: { Color3 }, -- the block's colours, top to foot
	Main: { Color3 }, -- a screen's one main action, filled
	Panel: { Color3 },
	Alpha: number,
	Button: { Color3 },
	Pressed: { Color3 },
	Edge: Color3,
	Glint: Color3,
	Channel: Color3,
	Text: Color3,
	Soft: Color3,
}
export type Palette = {
	Panel: { Color3 }, -- a panel's body, top to bottom
	Alpha: number,
	Edge: Color3,
	Border: number?, -- a bordered palette: its panels wear the bold edge
	Facet: Color3,
	Glint: Color3,
	Text: Color3,
	Soft: Color3,
	Faint: Color3,
	Channel: Color3,
	Well: Color3,
	Button: { Color3 },
	Pressed: { Color3 },
	Ground: Color3,
	Rim: number?, -- a bar's light keeps this dark rim all round
	Seat: number?, -- a frame sits in its dark seat
	Warm: { number }?, -- a warm light's edges on a pale panel
	Accent: Color3,
	Core: number,
	Selected: { Color3 }?, -- a selected button fills with these
	SelectedText: Color3?,
	Backing: Color3?, -- behind a full screen in this palette (Kit.Screen's cover); the theme's backing when nil
	Light: Color3?, -- a palette's own light: the seam's lit edges, rings and plates
	Ink: Color3?, -- words on that light
	Card: { Color3 }?, -- a card over the room, a step up from its panel
}

